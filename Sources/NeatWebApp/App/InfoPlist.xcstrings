{"sourceLanguage":"zh-Hans","strings":{"NSCameraUsageDescription":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Web apps need camera access after your approval, e.g. for video calls or capture."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网页应用需要在你授权后使用摄像头，例如视频通话或拍摄。"}}}},"NSMicrophoneUsageDescription":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Web apps need microphone access after your approval, e.g. for voice calls or recording."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网页应用需要在你授权后使用麦克风，例如语音通话或录音。"}}}}},"version":"1.0"}
