    "browser.permission.passkey.message" : {
      "comment" : "通行密钥在第三方网页应用内不可用的说明，%@ 是网页应用名。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS allows Passkeys in embedded web content only for full browsers. Web apps such as %@ cannot use this system capability. Sign in with a password or verification code instead, or open this page in your default browser." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 只允许正式浏览器在内嵌网页里使用通行密钥（Passkey），%@ 这类网页应用拿不到这项系统能力。可以改用密码或验证码登录，也可以在默认浏览器里打开这个页面完成登录。" } }
      }
    },
    "browser.permission.passkey.open_browser" : {
      "comment" : "通行密钥限制提示中的替代操作。",
