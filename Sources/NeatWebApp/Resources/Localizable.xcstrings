    "settings.virtual_notch.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "External displays, Mac mini, Mac Studio, and older MacBooks don’t have a hardware notch. When enabled, hovering briefly at the top center of the screen opens the launcher." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "外接显示器、Mac mini / Studio 与旧款 MacBook 没有硬件刘海。开启后屏幕顶部中央会有一块等效热区，指针停留一下即可唤出启动器。" } }
      }
    },
    "settings.virtual_notch.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable on Displays Without a Notch" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在没有刘海的屏幕上启用" } }
      }
    },
