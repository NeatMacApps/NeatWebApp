{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "settings.login.startup.blocked" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS has suspended this login item. Turn it back on once in System Settings." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统已挂起该登录项，需要在系统设置里重新打开一次。" } }
