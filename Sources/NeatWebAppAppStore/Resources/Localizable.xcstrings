        }
      }
    },
    "browser.permission.media.capability.camera": {
      "comment": "摄像头权限缺失时受影响的网页功能。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "video calls or capturing photos and video"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频通话或拍摄"
          }
