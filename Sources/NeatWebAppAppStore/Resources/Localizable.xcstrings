{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "browser.bookmark.add_failed": {
      "comment": "Registration failed or its acknowledgement timed out; retry reuses the destination ID.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm the new WebApp. Choose Add WebApp to retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认新 WebApp。请再次选择添加 WebApp 重试。"
          }
        }
      }
    },
    "browser.bookmark.add_webapp": {
      "comment": "Context menu: create a new isolated web app from this bookmark.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add WebApp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 WebApp"
          }
        }
      }
    },
    "browser.bookmark.added": {
      "comment": "The host acknowledged adding the new web app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WebApp Added"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加 WebApp"
          }
        }
      }
    },
    "browser.bookmark.adding": {
      "comment": "Cookie transfer and catalog registration are in progress.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding WebApp…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在添加 WebApp…"
          }
        }
      }
    },
    "browser.bookmark.close": {
      "comment": "Dismiss the bookmark popover.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Bookmarks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭收藏夹"
          }
        }
      }
    },
    "browser.bookmark.continue": {
      "comment": "Explicitly load the new app without importing its protected snapshot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue Without Cookies"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不使用 Cookie 继续"
          }
        }
      }
    },
    "browser.bookmark.copy_failed": {
      "comment": "Cookie verification failed before catalog registration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not copy cookies. Please retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法复制 Cookie，请重试。"
          }
        }
      }
    },
    "browser.bookmark.delete": {
      "comment": "收藏列表里删除一条收藏的按钮。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Bookmark"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除收藏"
          }
        }
      }
    },
    "browser.bookmark.empty": {
      "comment": "收藏列表为空时的说明。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No bookmarks yet. Click the star to save this page for this web app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有收藏。点星星可以把当前页面加进这个网页应用的收藏。"
          }
        }
      }
    },
    "browser.bookmark.name": {
      "comment": "Accessible label for the inline bookmark title editor.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏名称"
          }
        }
      }
    },
    "browser.bookmark.open": {
      "comment": "收藏列表里打开一条收藏的操作提示。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Bookmark"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开收藏"
          }
        }
      }
    },
    "browser.bookmark.rename": {
      "comment": "Commit the bookmark title edit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改名"
          }
        }
      }
    },
    "browser.bookmark.restore_failed": {
      "comment": "Shown in the new web app if its protected cookie handoff cannot be imported.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t Copy Cookies"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法复制 Cookie"
          }
        }
      }
    },
    "browser.bookmark.restore_message": {
      "comment": "Import failure choices. The protected snapshot remains available for retry.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry to keep your login, or continue without the copied cookies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试以保留登录状态，或不使用复制的 Cookie 继续。"
          }
        }
      }
    },
    "browser.bookmark.retry": {
      "comment": "Retry importing the protected cookie snapshot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "browser.chrome.bookmark.add": {
      "comment": "浏览器窗口顶部按钮：把当前页面加入这个网页应用的收藏。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark This Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏当前页面"
          }
        }
      }
    },
    "browser.chrome.bookmark.list": {
      "comment": "浏览器窗口顶部按钮：打开当前网页应用自己的收藏列表。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmarks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏夹"
          }
        }
      }
    },
    "browser.chrome.bookmark.remove": {
      "comment": "浏览器窗口顶部按钮：把当前页面从收藏里去掉。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Bookmark"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消收藏"
          }
        }
      }
    },
    "browser.chrome.collapse": {
      "comment": "浏览器窗口顶部按钮：将窗口收进侧边 Dock。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapse to Side Dock"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收进侧边刘海"
          }
        }
      }
    },
    "browser.chrome.more": {
      "comment": "Opens the native menu containing secondary browser actions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More Actions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多操作"
          }
        }
      }
    },
    "browser.chrome.pin": {
      "comment": "浏览器窗口顶部按钮：使窗口保持置顶。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Window on Top"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口置顶"
          }
        }
      }
    },
    "browser.chrome.reload": {
      "comment": "浏览器窗口顶部按钮：返回网页应用配置的地址并刷新。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "browser.chrome.unpin": {
      "comment": "浏览器窗口顶部按钮：取消窗口置顶。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Keeping Window on Top"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消窗口置顶"
          }
        }
      }
    },
    "browser.chrome.user_agent.desktop": {
      "comment": "浏览器窗口顶部按钮：将网页标识切换为桌面版。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Site"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面版"
          }
        }
      }
    },
    "browser.chrome.user_agent.mobile": {
      "comment": "浏览器窗口顶部按钮：将网页标识切换为手机版。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobile Site"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动版"
          }
        }
      }
    },
    "browser.download.accessibility.label": {
      "comment": "下载指示器的 VoiceOver 标签，%@ 是当前下载状态。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载：%@"
          }
        }
      }
    },
    "browser.download.bytes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        }
      }
    },
    "browser.download.clear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        }
      }
    },
    "browser.download.clear_finished": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Finished Downloads"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除已结束的下载记录"
          }
        }
      }
    },
    "browser.download.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Downloads"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭下载列表"
          }
        }
      }
    },
    "browser.download.dismiss": {
      "comment": "下载完成或失败提示上的关闭按钮，只清除状态提示，不删除文件。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss Download"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭提示"
          }
        }
      }
    },
    "browser.download.failed_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download failed: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载失败：%1$@"
          }
        }
      }
    },
    "browser.download.failed_missing_file": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download finished, but the saved file can't be found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载已完成，但无法定位保存文件。"
          }
        }
      }
    },
    "browser.download.file_missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File moved or deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已移动或删除。"
          }
        }
      }
    },
    "browser.download.help.reveal": {
      "comment": "下载完成时的操作提示，%@ 是文件名。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show %@ in Finder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中显示 %@"
          }
        }
      }
    },
    "browser.download.help.running": {
      "comment": "下载进行时的操作提示，%@ 是文件名。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载 %@"
          }
        }
      }
    },
    "browser.download.show": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Downloads"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示下载"
          }
        }
      }
    },
