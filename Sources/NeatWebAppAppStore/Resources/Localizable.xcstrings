    "browser.permission.camera.open_settings": {
      "comment": "摄像头权限被拒后的系统设置入口。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Camera Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开摄像头设置"
          }
        }
      }
    },
    "browser.permission.media.camera.title": {
      "comment": "网页摄像头权限被拒后的提示标题。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Is Unavailable to This Website"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页暂时无法使用摄像头"
          }
        }
      }
    },
    "browser.permission.media.camera_microphone.title": {
      "comment": "网页摄像头和麦克风权限被拒后的提示标题。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera and Microphone Are Unavailable to This Website"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页暂时无法使用摄像头和麦克风"
