    "browser.permission.media.message": {
      "comment": "网页媒体权限被拒后的说明，%1$@ 是网页应用名，%2$@ 是受影响功能。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You previously did not allow %1$@ to use the required device. You can still browse this website, but you cannot use %2$@ yet. After enabling the permission in System Settings, return here and it will be checked again automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你之前没有允许 %1$@ 使用所需设备，因此网页仍可浏览，但暂时不能进行%2$@。在系统设置中打开权限后，回到这里会自动重新检查。"
          }
        }
      }
    },
    "browser.permission.media.microphone.title": {
      "comment": "网页麦克风权限被拒后的提示标题。",
